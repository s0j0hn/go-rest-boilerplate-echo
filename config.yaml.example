app:
  environment: development  # development, staging, production
  log_level: info          # debug, info, warn, error

server:
  address: :8080
  port: 8080
  read_timeout: 30s
  write_timeout: 30s
  idle_timeout: 120s

database:
  host: DBHOST
  port: 5432
  user: DBUSER
  password: DBUSERPASSWORD
  name: DBNAME
  ssl_mode: disable

rabbitmq:
  host: RABBITMQHOST
  port: 5672
  user: RABBITMQUSER
  password: RABBITMQPASSWORD
  push_queue: push_queue
  listen_queue: listen_queue

websocket:
  address: :9090